rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      // Mandate email verification for all writes
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidWallet(data) {
      return data.keys().hasAll(['userId', 'address', 'label', 'walletType', 'isActive', 'alertsEnabled'])
        && data.userId == request.auth.uid
        && data.address is string && data.address.size() == 42
        && data.label is string && data.label.size() <= 100
        && data.walletType is string
        && data.isActive is bool
        && data.alertsEnabled is bool;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'txHash', 'blockNumber', 'timestamp', 'fromAddress', 'toAddress', 'amountFormatted', 'direction', 'riskLevel'])
        && data.userId == request.auth.uid
        && data.txHash is string && data.txHash.size() == 66
        && data.blockNumber is number
        && data.timestamp is number
        && data.fromAddress is string && data.fromAddress.size() == 42
        && data.toAddress is string && data.toAddress.size() == 42
        && data.amountFormatted is number
        && data.direction is string
        && data.riskLevel is string;
    }

    function isValidAlert(data) {
      return data.keys().hasAll(['userId', 'alertType', 'severity', 'walletAddress', 'txHash', 'amount', 'reason', 'status', 'createdAt'])
        && data.userId == request.auth.uid
        && data.alertType is string
        && data.severity is string
        && data.walletAddress is string && data.walletAddress.size() == 42
        && data.txHash is string && (data.txHash.size() == 66 || data.txHash.size() == 0)
        && data.amount is number
        && data.reason is string
        && data.status is string;
    }

    function isValidAlertRule(data) {
      return data.keys().hasAll(['userId', 'name', 'ruleType', 'threshold', 'severity', 'comparison', 'isActive'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.ruleType is string
        && data.threshold is number
        && data.severity is string
        && data.comparison is string
        && data.isActive is bool;
    }

    function isValidSettings(data) {
       return data.keys().hasAll(['userId', 'inApp', 'email', 'telegram', 'discord', 'minSeverity'])
         && data.userId == request.auth.uid;
    }

    // --- Collection Rules ---

    match /wallets/{walletId} {
      allow get: if isOwner(existing().userId);
      // Secure List Query: Enforce userId filter on the query
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidWallet(incoming());
      
      allow update: if isOwner(existing().userId) && isValidWallet(incoming()) && (
        incoming().userId == existing().userId
      );
      
      allow delete: if isOwner(existing().userId);
    }

    match /transactions/{txId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Transactions are usually written by system (Admin SDK), but we keep these for safety
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow delete: if isOwner(existing().userId);
    }

    match /alerts/{alertId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidAlert(incoming());
      allow update: if isOwner(existing().userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isOwner(existing().userId);
    }

    match /alertRules/{ruleId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidAlertRule(incoming());
      allow update: if isOwner(existing().userId) && isValidAlertRule(incoming());
      allow delete: if isOwner(existing().userId);
    }

    match /settings/{docId} {
      // docId MUST be the uid for direct get access
      allow get: if isOwner(docId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && isValidSettings(incoming());
    }

    // Global Telemetry (ReadOnly for authenticated users)
    match /risk/{docId} {
      allow read: if isSignedIn();
    }

    match /sync/{docId} {
      allow read: if isSignedIn();
    }
  }
}

