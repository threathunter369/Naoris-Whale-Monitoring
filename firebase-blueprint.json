{
  "entities": {
    "Wallet": {
      "title": "Wallet",
      "description": "Represents a monitored Ethereum wallet.",
      "type": "object",
      "properties": {
        "address": { "type": "string", "description": "Ethereum address of the wallet." },
        "label": { "type": "string", "description": "User-assigned label for the wallet." },
        "walletType": { "type": "string", "description": "Type of the wallet (e.g., Vesting, Multisig)." },
        "isActive": { "type": "boolean", "description": "Whether the wallet is currently being monitored." },
        "alertsEnabled": { "type": "boolean", "description": "Whether alerts are enabled for this wallet." },
        "naorisBalance": { "type": "string", "description": "Current NAORIS token balance." },
        "ethBalance": { "type": "string", "description": "Current ETH balance." },
        "lastActivityAt": { "type": "number", "description": "Timestamp of the last detected activity." },
        "createdAt": { "type": "number", "description": "Timestamp when the wallet was added." },
        "updatedAt": { "type": "number", "description": "Timestamp of the last update to this record." }
      },
      "required": ["address", "label", "walletType", "isActive", "alertsEnabled"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents a NAORIS token transfer transaction.",
      "type": "object",
      "properties": {
        "txHash": { "type": "string", "description": "Transaction hash." },
        "blockNumber": { "type": "number", "description": "Block number." },
        "timestamp": { "type": "number", "description": "Transaction timestamp." },
        "fromAddress": { "type": "string", "description": "Sender address." },
        "toAddress": { "type": "string", "description": "Receiver address." },
        "amountRaw": { "type": "string", "description": "Raw token amount." },
        "amountFormatted": { "type": "number", "description": "Formatted token amount." },
        "percentTotalSupply": { "type": "number", "description": "Percentage of total supply moved." },
        "tokenContract": { "type": "string", "description": "Token contract address." },
        "direction": { "type": "string", "description": "Direction relative to monitored wallets." },
        "riskLevel": { "type": "string", "description": "Calculated risk level of the transaction." },
        "status": { "type": "string", "description": "Transaction status (Confirmed/Pending)." },
        "usdValue": { "type": "number", "description": "Estimated USD value at transaction time." },
        "walletLabel": { "type": "string", "description": "Label of the monitored wallet involved." }
      },
      "required": ["txHash", "blockNumber", "timestamp", "fromAddress", "toAddress", "amountFormatted", "direction", "riskLevel"]
    },
    "Alert": {
      "title": "Alert",
      "description": "Represents a triggered alert for a risky transaction.",
      "type": "object",
      "properties": {
        "alertType": { "type": "string", "description": "Category of the alert." },
        "severity": { "type": "string", "description": "Severity level (Low/Medium/High/Critical)." },
        "walletAddress": { "type": "string", "description": "Wallet that triggered the alert." },
        "walletLabel": { "type": "string", "description": "Label of the triggered wallet." },
        "txHash": { "type": "string", "description": "Associated transaction hash." },
        "amount": { "type": "number", "description": "Amount involved in the transaction." },
        "reason": { "type": "string", "description": "Reason for the alert." },
        "recommendedAction": { "type": "string", "description": "Action suggested for the user." },
        "status": { "type": "string", "description": "User status (New/Reviewed/Ignored)." },
        "createdAt": { "type": "number", "description": "Timestamp of the alert creation." }
      },
      "required": ["alertType", "severity", "walletAddress", "txHash", "amount", "reason", "status", "createdAt"]
    },
    "NotificationSettings": {
      "title": "NotificationSettings",
      "description": "User settings for notification channels.",
      "type": "object",
      "properties": {
        "inApp": { "type": "boolean" },
        "email": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "recipient": { "type": "string" }
          }
        },
        "telegram": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "chatId": { "type": "string" }
          }
        },
        "discord": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "webhookUrl": { "type": "string" }
          }
        },
        "minSeverity": { "type": "string" }
      }
    },
    "RiskScore": {
      "title": "RiskScore",
      "description": "Calculated whale risk score and factors.",
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "lastUpdated": { "type": "number" },
        "explanation": { "type": "string" },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "impact": { "type": "number" }
            }
          }
        }
      }
    },
    "SyncState": {
      "title": "SyncState",
      "description": "Blockchain synchronization state.",
      "type": "object",
      "properties": {
        "lastBlock": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "wallets": {
      "schema": "Wallet",
      "description": "Monitored wallets collection."
    },
    "transactions": {
      "schema": "Transaction",
      "description": "Token transfer logs."
    },
    "alerts": {
      "schema": "Alert",
      "description": "Security alerts logs."
    },
    "settings": {
      "schema": "NotificationSettings",
      "description": "System settings (usually one doc with ID 'notifications')."
    },
    "risk": {
      "schema": "RiskScore",
      "description": "Daily risk score (usually one doc with ID 'current')."
    },
    "sync": {
      "schema": "SyncState",
      "description": "Blockchain sync state (usually one doc with ID 'ethereum')."
    }
  }
}
